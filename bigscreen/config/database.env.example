# 数据库连接模板：复制为 config/database.env 后按本机情况修改（该文件已被 .gitignore 忽略）
#
#   部署机（Ubuntu/CentOS，执行过 deploy/deploy.sh）：
#       默认使用应用账号 charging / charging123，deploy.sh 会自动创建该账号并建库
#   本地 Windows 开发：
#       MySQL 的 root 通常免密，改成 DB_USER=root / DB_PASSWORD=
#
# 也支持用环境变量覆盖（优先级最高）：DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME / DATA_SOURCE

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=charging
DB_PASSWORD=charging123
DB_NAME=charging_screen

# 正式链路固定 mysql：ADS ORC 经本地管道符 TXT 幂等同步至 MySQL 后供 Flask 读取。
# MySQL 服务端需启用 local_infile=1，客户端使用 LOAD DATA LOCAL INFILE。
DATA_SOURCE=mysql
CACHE_TTL=30

# 数据库超时与熔断：MySQL 重启或网络异常时，避免接口逐个查询等待导致前端 20s 超时
DB_CONNECT_TIMEOUT=3
DB_READ_TIMEOUT=8
DB_WRITE_TIMEOUT=8
DB_POOL_TIMEOUT=1
DB_BREAKER_SECONDS=30
