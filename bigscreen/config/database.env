# 数据库连接配置：Flask 后端与 Spark 装载脚本共用（环境变量优先级更高）
#
#   本地 Windows 开发：一般用 root + 空密码（下面就是默认值）
#   虚拟机 / 服务器部署：deploy/deploy.sh 会自动创建应用账号并**改写本文件**
#       （本项目的虚拟机为 DB_USER=charging / DB_PASSWORD=charging123）
#   注意：用代码同步工具覆盖整个项目时不要把本文件覆盖回去，否则会连不上库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=charging_screen

# 后端数据源：mysql（默认，读取 Spark 结果表）或 csv（无 MySQL 时兜底）
DATA_SOURCE=mysql
# 大屏数据缓存时间（秒）
CACHE_TTL=30
